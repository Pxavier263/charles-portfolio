# Public site URL (used for canonical links, Open Graph and sitemap)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Optional: form endpoint for the contact form (e.g. a Formspree form URL).
# Leave empty to use the built-in mailto fallback. Never put secret API keys in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_FORM_ENDPOINT=
